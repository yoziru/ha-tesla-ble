{
  "config": {
    "step": {
      "bluetooth": {
        "title": "Tesla vehicle discovered",
        "description": "A Tesla vehicle ({name}) was discovered. Enter its VIN to continue."
      },
      "user": {
        "title": "Add a Tesla vehicle",
        "description": "Select a discovered vehicle or enter its Bluetooth address manually.",
        "data": {
          "address": "Vehicle"
        }
      },
      "manual": {
        "title": "Bluetooth address",
        "description": "Enter the Tesla BLE address from Home Assistant's Bluetooth advertisement monitor or carcheck.py --scan. Use the BLE address, not the Bluetooth audio address.",
        "data": {
          "address": "Bluetooth address"
        }
      },
      "reconfigure": {
        "title": "Change Bluetooth address",
        "description": "Change the Bluetooth address without losing the vehicle's paired key.",
        "data": {
          "address": "Bluetooth address"
        }
      },
      "vin": {
        "title": "Vehicle identification number",
        "description": "Enter the 17-character VIN of the vehicle at {address}. You can find it on the windshield, in the vehicle under Controls → Software, or on your registration.",
        "data": {
          "vin": "VIN"
        }
      },
      "role": {
        "title": "Vehicle key access",
        "description": "All modes read vehicle data.\n\n- **Vehicle controls** (default): normal controls, without key or access management.\n- **Charging controls**: start/stop, amps and charge limit. No charge-port controls; wake needs compatible car software.\n- **Read-only monitoring**: no vehicle controls; refresh does not wake the car.\n\nAccess cannot be changed in integration options.",
        "data": {"role": "Access level"}
      },
      "pair": {
        "title": "Pair with your vehicle",
        "description": "Pair Home Assistant's key with **{role}** access.\n\n1. Keep the car awake and nearby.\n2. Press **Submit**, then tap your key card on the center console.\n3. Approve on the car's screen and remove the card.\n\nTo retry, enable **Pair vehicle** on the device's entity page, then press it."
      }
    },
    "error": {
      "invalid_vin": "That does not look like a valid VIN (17 characters, no I/O/Q).",
      "invalid_address": "That does not look like a valid Bluetooth address (AA:BB:CC:DD:EE:FF).",
      "name_mismatch": "The advertised name does not match this VIN. Check both and try again."
    },
    "abort": {
      "already_configured": "This vehicle is already configured.",
      "not_supported": "This Bluetooth device is not a Tesla vehicle.",
      "not_seen": "The vehicle stopped advertising before setup started.",
      "reconfigure_successful": "Bluetooth address updated."
    }
  },
