          "address": "Vehicle"
        }
      },
      "manual": {
        "title": "Bluetooth address",
        "description": "Enter the Tesla BLE address from Home Assistant's Bluetooth advertisement monitor or carcheck.py --scan. Use the BLE address, not the Bluetooth audio address.",
